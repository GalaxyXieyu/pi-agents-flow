{
  "name": "pi-agents-flow",
  "version": "0.1.0-alpha.6",
  "description": "Supervisor-led multi-Agent orchestration for Pi with durable workflows, quality gates, and observable subagents",
  "author": "GalaxyXieyu, based on pi-subagents by Nico Bailon",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./headless": "./src/extension/headless.ts",
    "./background-work": "./src/api/background-work.ts",
    "./delegation": "./src/api/delegation.ts",
    "./capability-ceiling": "./src/api/capability-ceiling.ts",
    "./preflight": "./src/api/preflight.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GalaxyXieyu/pi-agents-flow.git"
  },
  "homepage": "https://github.com/GalaxyXieyu/pi-agents-flow#readme",
  "bugs": {
    "url": "https://github.com/GalaxyXieyu/pi-agents-flow/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "subagents",
    "ai",
    "agents",
    "cli"
  ],
  "files": [
    "index.ts",
    "src/**/*.ts",
    "agents/",
    "assets/avatars/*",
    "skills/**/*",
    "prompts/**/*",
    "README.md",
    "TEACHING.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "SUPPORT.md",
    "RELEASING.md",
    "UPSTREAM.md",
    "docs/pi-agents-flow-overview.zh-CN.md",
    "docs/images/*"
  ],
  "scripts": {
    "benchmark:workflow": "node --experimental-strip-types scripts/workflow-benchmark.ts",
    "benchmark:timings": "node --experimental-strip-types scripts/benchmark-timings.ts",
    "benchmark:regression": "node scripts/check-benchmark-regression.mjs",
    "benchmark:headless-decisions": "node --experimental-strip-types --import ./test/support/forbid-ui-loader.mjs scripts/headless-decision-benchmark.ts",
    "benchmark:headless-decisions:check": "node scripts/check-headless-decision-regression.mjs --baseline benchmarks/headless-decisions/baseline.json --current benchmarks/headless-decisions/latest.json",
    "check:rpiv-todo-bridge": "node scripts/check-rpiv-todo-bridge.mjs",
    "check:runtime-paths": "node scripts/check-runtime-paths.mjs",
    "check:deps": "depcruise src --config .dependency-cruiser.cjs",
    "check:deps:ci": "npm run check:deps && node scripts/check-dependency-baseline.mjs",
    "smoke:pack": "node scripts/smoke-pack.mjs",
    "test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --test test/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --import ./test/support/register-loader.mjs --test test/integration/*.test.ts",
    "test:e2e": "node --experimental-strip-types --import ./test/support/register-loader.mjs --test test/e2e/*.test.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "tag": "alpha"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": ">=0.81.0",
    "@earendil-works/pi-ai": ">=0.81.0",
    "@earendil-works/pi-coding-agent": ">=0.81.0",
    "@earendil-works/pi-tui": ">=0.81.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "dependencies": {
    "jiti": "2.7.0",
    "typebox": "1.1.38",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.81.0",
    "@earendil-works/pi-ai": "0.81.0",
    "@earendil-works/pi-coding-agent": "0.81.0",
    "@earendil-works/pi-tui": "0.81.0",
    "dependency-cruiser": "18.1.1",
    "typescript": "5.9.3"
  }
}
