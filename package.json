{
  "name": "pi-agents-flow",
  "version": "0.1.0",
  "description": "Supervisor-led multi-agent workflow extension for Pi with dynamic orchestration, durable recovery, quality gates, and observable subagents",
  "author": "GalaxyXieyu, based on pi-subagents by Nico Bailon",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./index.ts",
    "./background-work": "./src/api/background-work.ts",
    "./delegation": "./src/api/delegation.ts",
    "./capability-ceiling": "./src/api/capability-ceiling.ts",
    "./preflight": "./src/api/preflight.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GalaxyXieyu/pi-agents-flow.git"
  },
  "homepage": "https://github.com/GalaxyXieyu/pi-agents-flow#readme",
  "bugs": {
    "url": "https://github.com/GalaxyXieyu/pi-agents-flow/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "subagents",
    "ai",
    "agents",
    "cli"
  ],
  "files": [
    "index.ts",
    "src/**/*.ts",
    "agents/",
    "assets/avatars/*",
    "skills/**/*",
    "prompts/**/*",
    "README.md",
    "CHANGELOG.md"
  ],
	"scripts": {
		"benchmark:workflow": "node --experimental-strip-types scripts/workflow-benchmark.ts",
		"check:rpiv-todo-bridge": "node scripts/check-rpiv-todo-bridge.mjs",
		"test": "npm run test:unit",
    "test:unit": "node --experimental-strip-types --test test/unit/*.test.ts",
    "test:integration": "node --experimental-strip-types --import ./test/support/register-loader.mjs --test test/integration/*.test.ts",
    "test:e2e": "node --experimental-strip-types --import ./test/support/register-loader.mjs --test test/e2e/*.test.ts",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:e2e"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": ">=0.80.0",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-agent-core": {
      "optional": true
    },
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "dependencies": {
    "jiti": "2.7.0",
    "typebox": "1.1.38",
    "yaml": "2.8.3"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "0.81.0",
    "@earendil-works/pi-ai": "0.81.0",
    "@earendil-works/pi-coding-agent": "0.81.0",
    "@earendil-works/pi-tui": "0.81.0"
  }
}
